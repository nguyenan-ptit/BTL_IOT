# Sao chép thành .env rồi điền. Không commit file .env.
# Token do @BotFather cấp (chấp nhận cả tên BOT_TOKEN).
TELEGRAM_BOT_TOKEN=
# Địa chỉ backend, ví dụ https://xxxx.trycloudflare.com (đổi mỗi lần chạy lại tunnel)
BE_BASE_URL=
# Khoá mã hoá mật khẩu người dùng. Tạo bằng:
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# Đổi khoá thì mọi người phải /login lại.
BOT_SECRET_KEY=
POLL_SECONDS=3
REMIND_SECONDS=10
DB_PATH=bot.db
# Website để mở chi tiết sự cố từ tin nhắn
WEB_BASE_URL=https://frontend-iot-web-crm.vercel.app
# Chủ trọ: báo node mất kết nối sau bao nhiêu giây, lỗi cảm biến sau bao nhiêu giây, hỏi lại mỗi bao nhiêu giây
OFFLINE_ALERT_SECONDS=60
FAULT_ALERT_SECONDS=30
MONITOR_SECONDS=10
