# Môi trường chạy ứng dụng; điều chỉnh theo cấu hình thực tế.
APP_ENV=development

# Backend reads process environment; .env is not loaded automatically.
JWT_SECRET=70b368628d37a244c40c9638bc00f2ab2b830bade92f91f97ce5637287e8519b
IOT_MYSQL_HOST=127.0.0.1
IOT_MYSQL_PORT=3306
IOT_MYSQL_USER=iot_app
IOT_MYSQL_PASSWORD=mật_khẩu_bạn_tự_chọn
IOT_MYSQL_DATABASE=iot_db
# Optional path to trusted CA for MySQL TLS.
# IOT_MYSQL_SSL_CA=C:/path/to/mysql-ca.pem

# Separate from MQTT usernames/passwords. URL includes deployment prefix and /api/v5.
IOT_EMQX_DEPLOYMENT=disabled
IOT_EMQX_API_URL=
IOT_EMQX_API_KEY=
IOT_EMQX_API_SECRET=
# Set true only after checking the authentication/ACL policy in docs/LONG_API.md.
IOT_EMQX_POLICY_VERIFIED=false
